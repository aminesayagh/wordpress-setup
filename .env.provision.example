# Provisioning settings read by new-site.py. Copy to .env.provision.
#
#   cp .env.provision.example .env.provision
#
# This file is NOT copied into generated sites — it only configures the generator.

# Shared tunnel that publishes every WordPress site. new-site.py adds the ingress
# rule and DNS record to it automatically — normally you never touch this.
TUNNEL_NAME=wordpress

# Escape hatch: set a token to give ONE site its own cloudflared instead of using
# the shared tunnel. That site then needs its own tunnel created in the dashboard
# and its own route (-> http://nginx:80). Leave empty for the normal flow.
CLOUDFLARE_TUNNEL_TOKEN=

# Used by remove-site.py to delete a site's DNS record (cloudflared can create
# routes but not delete them). Create at dash.cloudflare.com > My Profile >
# API Tokens > Create Token, permission: Zone > DNS > Edit, scoped to your zone.
# Optional — without it removal does everything else and leaves the record.
CLOUDFLARE_API_TOKEN=

# Admin email offered as the default at the prompt.
WP_ADMIN_EMAIL=aminesayagh1997@gmail.com

# Sites are created at <slug>.<DOMAIN_SUFFIX>.
DOMAIN_SUFFIX=masayagh.com

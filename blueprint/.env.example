# Unique Docker Compose project name.
COMPOSE_PROJECT_NAME=wp-example

# Website identity.
SITE_NAME=Example Website
WP_DOMAIN=example.masayagh.com

# Optional local browser access.
LOCAL_HTTP_PORT=8080

# WordPress database configuration.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress

# WordPress configuration.
WP_TABLE_PREFIX=wp_
WP_ENVIRONMENT_TYPE=development

# Debug: 1 to enable, empty to disable. Any non-empty value counts as enabled,
# so use WP_DEBUG= (not "false") to turn it off.
WP_DEBUG=1

# Run PHP-FPM as your WSL user so ./site stays editable from the host.
# Check with: id -u && id -g
HOST_UID=1000
HOST_GID=1000

# PHP behavior. Only PHP_UPLOAD_LIMIT is used (Nginx client_max_body_size).
# The PHP-side limits live in docker/php/custom.ini — keep them in sync.
PHP_UPLOAD_LIMIT=128M
